# =============================================================================
# .gitignore — OptoBind-AI
# =============================================================================

# ── Poids lourds de modèles (> 100 Mo rejetés par GitHub) ─────────────────────
weights/*.pt
weights/*.bin
weights/*.pth
weights/*.ckpt
weights/chai-1/
weights/alphafold3/
*.pt

# ── Dépôts tiers clonés (automatiquement clonés par setup_env.sh) ─────────────
RFdiffusion/
ProteinMPNN/

# ── Sorties et logs de calculs ────────────────────────────────────────────────
outputs/
*.log

# ── Cache Python & Bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Caches de test et couverture ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Environnements virtuels & configurations locales ─────────────────────────
.env
.venv
env/
venv/
ENV/

# ── Fichiers système & IDE ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
